C finish
(* threads/src/finish.rs wait against finished: the caller sets SLEEPING
   and reads the count in one fetch_or; a finisher adds its pieces and
   reads SLEEPING in one fetch_add, on the same word. Forbidden: the
   caller reads a count without the finisher's piece (and parks) while
   the finisher reads no SLEEPING (and unparks no one). The two
   read-modify-writes on one word are ordered by coherence alone, so this
   holds at any ordering; the code's SeqCst is for finish_outputs. *)
{ [state]=0; }

P0 (atomic_int* state) {
  int r0 = atomic_fetch_or_explicit(state, 2, memory_order_seq_cst);
}

P1 (atomic_int* state) {
  int r0 = atomic_fetch_add_explicit(state, 1, memory_order_seq_cst);
}

exists (0:r0=0 /\ 1:r0=0)
