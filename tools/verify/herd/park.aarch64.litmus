AArch64 park.aarch64
(* park.litmus as rustc compiles it for aarch64-apple-darwin (LSE,
   RCpc): Release store STLR, fence(SeqCst) DMB ISH, SeqCst load LDAR,
   SeqCst fetch_or LDSETAL, Acquire load LDAPR. *)
{ 0:X1=published; 0:X3=parked; 1:X1=published; 1:X3=parked; }
 P0             | P1                  ;
 MOV X0,#1      | MOV X0,#1           ;
 STLR X0,[X1]   | LDSETAL X0,X9,[X3]  ;
 DMB ISH        | DMB ISH             ;
 LDAR X2,[X3]   | LDAPR X2,[X1]       ;
exists (0:X2=0 /\ 1:X2=0)
