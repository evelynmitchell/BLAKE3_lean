AArch64 sme2.aarch64
(* sme2.litmus as rustc compiles it for aarch64-apple-darwin: Release
   store STLR, fence(SeqCst) DMB ISH, SeqCst swap SWPAL; SeqCst store
   STLR, DMB ISH, Acquire load LDAPR (or LDAR, which orders more). *)
{ 0:X1=published; 0:X3=parked; 1:X1=published; 1:X3=parked; }
 P0                 | P1             ;
 MOV X0,#1          | MOV X0,#1      ;
 STLR X0,[X1]       | STLR X0,[X3]   ;
 DMB ISH            | DMB ISH        ;
 MOV X4,#0          | LDAPR X2,[X1]  ;
 SWPAL X4,X2,[X3]   |                ;
exists (0:X2=0 /\ 1:X2=0)
